@page
@model wt_lab5_5razor_savostikova.Pages.Products.DeleteModel

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm rounded-4 border-danger">
                <div class="card-body p-4 text-center">
                    <h2 class="text-danger mb-4">Удаление блюда</h2>
                    <p>Вы уверены, что хотите удалить это блюдо?</p>
                    
                    <div class="alert alert-secondary my-4">
                        <h4>@Model.Dish.Name</h4>
                        <p class="mb-0">@Model.Dish.Price руб.</p>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="Dish.Id" />
                        <button type="submit" class="btn btn-danger">Да, удалить</button>
                        <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>