@page
@model wt_lab5_5razor_savostikova.Pages.Products.DetailsModel

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h1>@Model.Dish.Name</h1>
                        <span class="badge bg-secondary fs-6">ID: @Model.Dish.Id</span>
                    </div>
                    
                    <p class="text-muted">Категория: @Model.Dish.Category</p>
                    <p>@Model.Dish.Description</p>
                    
                    <p class="fs-3 fw-bold">@Model.Dish.Price руб.</p>
                    
                    <span class="badge @(Model.Dish.IsAvailable ? "bg-success" : "bg-danger") fs-6 mb-4">
                        @(Model.Dish.IsAvailable ? "В наличии" : "Нет в наличии")
                    </span>

                    <div class="mt-4">
                        <a asp-page="./Index" class="btn btn-secondary">Назад к списку</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>