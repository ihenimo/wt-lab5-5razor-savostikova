@page
@model wt_lab5_5razor_savostikova.Pages.Products.IndexModel

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Меню доставки еды</h1>
            <p class="text-muted">Всего блюд: @Model.Dishes.Count</p>
        </div>
        <a asp-page="/Products/Create" class="btn btn-primary">Добавить блюдо</a>
    </div>

    <div class="row g-4">
        @foreach (var dish in Model.Dishes)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2 align-self-start">ID: @dish.Id</span>
                        <h5 class="card-title">@dish.Name</h5>
                        <p class="text-muted mb-2">@dish.Category</p>
                        <p class="fs-4 fw-bold">@dish.Price руб.</p>
                        <span class="badge @(dish.IsAvailable ? "bg-success" : "bg-danger") mb-3">
                            @(dish.IsAvailable ? "В наличии" : "Нет в наличии")
                        </span>
                        
                        <!-- Блок с кнопками -->
                        <div class="mt-auto">
                            <a asp-page="/Products/Details" asp-route-id="@dish.Id" class="btn btn-outline-primary w-100 mb-2">Подробнее</a>
                            <a asp-page="/Products/Delete" asp-route-id="@dish.Id" class="btn btn-outline-danger w-100">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>